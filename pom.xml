<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.magellan2.elcano</groupId>
  <artifactId>magellan-ee</artifactId>
  <version>${revision}${changelist}</version>
  <packaging>jar</packaging>

  <name>Magellan Elcano Edition (EE)</name>
  <description>Magellan Elcano Edition (EE), a client for the Eressea play-by-email game, derived from Magellan 2.</description>
  <url>https://github.com/awa-22-22/magellan2-Elcano-Edition</url>

  <licenses>
    <license>
      <name>GNU General Public License, version 2</name>
      <url>https://www.gnu.org/licenses/old-licenses/gpl-2.0.html</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <scm>
    <url>https://github.com/awa-22-22/magellan2-Elcano-Edition</url>
    <connection>scm:git:https://github.com/awa-22-22/magellan2-Elcano-Edition.git</connection>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/awa-22-22/magellan2-Elcano-Edition/issues</url>
  </issueManagement>

  <properties>
    <!--
      CI-friendly version: ${revision}${changelist}. Local builds are
      "<revision>-SNAPSHOT". The test-build workflow appends the push time
      (-Dchangelist=-SNAPSHOT.yyyymmdd-hhmm); a release build passes an
      empty -Dchangelist=.
    -->
    <revision>1.0.0</revision>
    <changelist>-SNAPSHOT</changelist>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>ISO-8859-1</project.build.sourceEncoding>
    <project.reporting.outputEncoding>ISO-8859-1</project.reporting.outputEncoding>
  </properties>

  <!--
    All libraries come from Maven Central (issue #2); local jars (system
    scope) are rejected by the maven-enforcer-plugin below. Every compile and
    runtime dependency is bundled into the executable jar by the
    maven-shade-plugin.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>2.21.4</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <!-- docking framework of the client desktop -->
      <groupId>io.github.andrewauclair</groupId>
      <artifactId>modern-docking-api</artifactId>
      <version>1.4.9</version>
    </dependency>
    <dependency>
      <groupId>io.github.andrewauclair</groupId>
      <artifactId>modern-docking-single-app</artifactId>
      <version>1.4.9</version>
    </dependency>
    <dependency>
      <!-- modern look and feel (FlatLaf Light/Dark/IntelliJ/Darcula/macOS), see etc/plaf.ini -->
      <groupId>com.formdev</groupId>
      <artifactId>flatlaf</artifactId>
      <version>3.7.2</version>
    </dependency>
    <dependency>
      <!-- bar chart in the skill chart of the faction statistics -->
      <groupId>org.jfree</groupId>
      <artifactId>jfreechart</artifactId>
      <version>1.5.6</version>
    </dependency>

    <dependency>
      <groupId>commons-beanutils</groupId>
      <artifactId>commons-beanutils</artifactId>
      <version>1.11.0</version>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-compress</artifactId>
      <version>1.28.0</version>
    </dependency>
    <dependency>
      <groupId>commons-codec</groupId>
      <artifactId>commons-codec</artifactId>
      <version>1.22.1</version>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-email</artifactId>
      <version>1.6.0</version>
    </dependency>
    <dependency>
      <!-- javax.mail API (also brings jakarta.activation = javax.activation) -->
      <groupId>com.sun.mail</groupId>
      <artifactId>jakarta.mail</artifactId>
      <version>1.6.7</version>
    </dependency>
    <dependency>
      <groupId>commons-logging</groupId>
      <artifactId>commons-logging</artifactId>
      <version>1.3.5</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>javax.help</groupId>
      <artifactId>javahelp</artifactId>
      <version>2.0.05</version>
    </dependency>
    <dependency>
      <groupId>io.github.parubok</groupId>
      <artifactId>multiline-label</artifactId>
      <version>1.20</version>
    </dependency>

    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.hamcrest</groupId>
      <artifactId>hamcrest-core</artifactId>
      <version>1.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!--
        Only magellan-version.properties is taken from src/main/resources and
        filtered (${project.version}); it ends up in the jar so that the program
        knows its own version, see magellan.library.utils.VersionInfo.
      -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <!-- expose the resolved dependency jars as properties (javahelp indexer below) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>jar-paths</id>
            <phase>initialize</phase>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        Build rules: no local jars (system scope) and the minimum Java and
        Maven versions.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.7.0</version>
        <executions>
          <execution>
            <id>enforce-build-rules</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[11,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.6.3,)</version>
                </requireMavenVersion>
                <bannedDependencies>
                  <excludes>
                    <exclude>*:*:*:*:system</exclude>
                  </excludes>
                  <message>Local jars (system scope) are not allowed, use Maven Central.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- register the Eclipse source folders -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>add-source</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>src-library</source>
                <source>src-client</source>
                <source>src-plugins</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>add-test-source</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>src-test</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <argLine>-Djava.awt.headless=true</argLine>
          <excludes>
            <!-- not part of the release -->
            <exclude>**/E3CommandParserTest.java</exclude>
          </excludes>
        </configuration>
      </plugin>

      <!--
        Ant tasks before packaging: index the JavaHelp set (search database)
        and generate etc/VERSION.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>index-help</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <!-- index a copy of help/ in the classes directory, so the source
                     tree stays clean and the help ends up in the jar -->
                <delete dir="${project.build.outputDirectory}/help" />
                <copy todir="${project.build.outputDirectory}/help">
                  <fileset dir="${project.basedir}/help"
                           excludes="META-INF/**,readme.txt,*/JavaHelpSearch/**" />
                </copy>
                <macrodef name="index-help">
                  <attribute name="lang" />
                  <sequential>
                    <fileset id="help.set.@{lang}"
                             dir="${project.build.outputDirectory}/help/@{lang}"
                             casesensitive="yes">
                      <include name="**/*.html" />
                    </fileset>
                    <pathconvert refid="help.set.@{lang}" property="help.files.@{lang}"
                                 pathsep="' '">
                      <map from="${project.build.outputDirectory}/help/@{lang}/" to="" />
                    </pathconvert>
                    <java classname="com.sun.java.help.search.Indexer"
                          dir="${project.build.outputDirectory}/help/@{lang}"
                          fork="true" failonerror="true" maxmemory="512m">
                      <arg line="'${help.files.@{lang}}'" />
                      <classpath>
                        <pathelement location="${javax.help:javahelp:jar}" />
                      </classpath>
                    </java>
                  </sequential>
                </macrodef>
                <index-help lang="de" />
                <index-help lang="en" />
              </target>
            </configuration>
          </execution>
          <execution>
            <!-- etc/VERSION is read at runtime (title, About dialog, update check) -->
            <id>generate-version-file</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <copy file="${project.basedir}/etc/VERSION.template"
                      tofile="${project.build.directory}/generated/etc/VERSION"
                      overwrite="true">
                  <filterset>
                    <filter token="VERSION" value="${project.version}" />
                    <filter token="SEMANTIC_VERSION" value="${project.version}" />
                  </filterset>
                </copy>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Build the executable fat jar: the jar of maven-jar-plugin (classes,
        resources, JavaHelp with search index) plus all compile and runtime
        dependencies. It replaces the thin jar. On duplicate entries the first
        dependency in the order of this pom wins; service files are merged.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <id>build-fat-jar</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <!-- signatures would be invalid in the merged jar; module
                       descriptors do not apply to a merged jar -->
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>magellan.client.Client</mainClass>
                  <manifestEntries>
                    <Specification-Title>Magellan Client ${project.version}</Specification-Title>
                    <Specification-Vendor>Magellan Development Team</Specification-Vendor>
                  </manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Assemble the runnable distribution zip (fat jar + etc/ + doc/ +
        start scripts), mirroring the Ant copy_release_data/zip_release
        targets. Declared after the maven-shade-plugin so the fat jar already
        exists when this runs (both are bound to the package phase; same-phase
        executions run in declaration order).
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.7.1</version>
        <executions>
          <execution>
            <id>build-dist-zip</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
            <configuration>
              <descriptors>
                <descriptor>${project.basedir}/src/assembly/dist.xml</descriptor>
              </descriptors>
              <appendAssemblyId>true</appendAssemblyId>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
